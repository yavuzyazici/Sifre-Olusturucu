<?xml version="1.0" encoding="utf-8"?>
<!--
	IIS yapılandırması — statik SvelteKit çıktısı için.

	Bu dosya `static/` altında durur, yani `npm run build` sırasında olduğu gibi
	`build/` klasörünün köküne kopyalanır. Sunucuya `build/` içeriğini
	yüklediğinizde web.config da yanında gider. (IIS kendi web.config dosyasını
	dışarıya sunmaz, içeriği güvendedir.)

	YÖNLENDİRMELER: Alan adı şu an Cloudflare arkasında ve http -> https ile
	apex -> www yönlendirmeleri orada zaten çalışıyor. Bu yüzden yönlendirme
	kuralları aşağıda yorum içinde bırakıldı. Cloudflare'den çıkarsanız ya da
	yönlendirmeler çalışmayı bırakırsa o bloğu yorumdan çıkarmanız yeterli.
	Dikkat: <rewrite> bölümü IIS'in "URL Rewrite" modülünü gerektirir; modül
	kurulu değilse site komple 500.19 hatası verir.
-->
<configuration>
	<system.webServer>

		<!-- Klasör istendiğinde index.html sunulsun. `clear` ile default.aspx gibi
		     .NET'ten kalma varsayılanlar devre dışı bırakılıyor. -->
		<defaultDocument>
			<files>
				<clear />
				<add value="index.html" />
			</files>
		</defaultDocument>

		<directoryBrowse enabled="false" />

		<staticContent>
			<!-- IIS varsayılan kurulumunda bu türler çoğu zaman tanımlı değildir;
			     tanımsız uzantılar 404 döner. -->
			<remove fileExtension=".webp" />
			<mimeMap fileExtension=".webp" mimeType="image/webp" />
			<remove fileExtension=".woff2" />
			<mimeMap fileExtension=".woff2" mimeType="font/woff2" />
			<remove fileExtension=".svg" />
			<mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
			<remove fileExtension=".json" />
			<mimeMap fileExtension=".json" mimeType="application/json" />
			<remove fileExtension=".webmanifest" />
			<mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />

			<!-- Varsayılan: HTML, robots.txt, sitemap.xml önbelleğe alınmasın ki
			     yeni yayın anında görünsün. Değişmeyen dosyalar aşağıda ayrıca
			     uzun ömürlü olarak tanımlanıyor. -->
			<clientCache cacheControlMode="DisableCache" />
		</staticContent>

		<!-- Eşleşmeyen adreslerde SvelteKit'in ürettiği 404 sayfası, 404 durum
		     koduyla birlikte sunulur. -->
		<httpErrors errorMode="Custom" existingResponse="Replace">
			<remove statusCode="404" subStatusCode="-1" />
			<error statusCode="404" path="404.html" responseMode="File" />
		</httpErrors>

		<urlCompression doStaticCompression="true" doDynamicCompression="true" />

		<httpProtocol>
			<customHeaders>
				<remove name="X-Powered-By" />
				<add name="X-Content-Type-Options" value="nosniff" />
				<add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
				<add name="X-Frame-Options" value="SAMEORIGIN" />
				<add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=(), interest-cohort=()" />
			</customHeaders>
		</httpProtocol>

		<!--
			Yönlendirmeler şu an Cloudflare tarafında. Gerekirse aşağıdaki
			yorumu kaldırın (URL Rewrite modülü şart).

		<rewrite>
			<rules>
				<rule name="HTTPS'e yonlendir" stopProcessing="true">
					<match url="(.*)" />
					<conditions logicalGrouping="MatchAll">
						<add input="{HTTPS}" pattern="^OFF$" />
						<add input="{HTTP_HOST}" pattern="^localhost" negate="true" />
						<add input="{HTTP_X_FORWARDED_PROTO}" pattern="^https$" negate="true" />
					</conditions>
					<action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
				</rule>

				<rule name="apex adresi www'ya yonlendir" stopProcessing="true">
					<match url="(.*)" />
					<conditions>
						<add input="{HTTP_HOST}" pattern="^sifreolusturucu\.com$" />
					</conditions>
					<action type="Redirect" url="https://www.sifreolusturucu.com/{R:1}" redirectType="Permanent" />
				</rule>
			</rules>
		</rewrite>

			HTTPS kuralındaki X_FORWARDED_PROTO koşulu önemli: Cloudflare "Flexible
			SSL" modunda origin sunucuya HTTP ile bağlanır. O koşul olmadan IIS
			isteği tekrar https'e yönlendirir, Cloudflare yine http olarak
			iletir ve sonsuz yönlendirme döngüsü oluşur.
		-->

	</system.webServer>

	<!-- İçerik özetli (hash'li) dosya adları: içerik değişirse ad da değişir,
	     bu yüzden bir yıl boyunca önbellekte tutulabilir. -->
	<location path="_app/immutable">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
			</staticContent>
		</system.webServer>
	</location>

	<!-- Poppins dosya adları Google'ın sürüm özetini taşıyor, sabit. -->
	<location path="css/Fonts">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
			</staticContent>
		</system.webServer>
	</location>

	<!-- Görseller: adları sabit değil, bu yüzden 30 gün. -->
	<location path="resimler">
		<system.webServer>
			<staticContent>
				<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" cacheControlCustom="public" />
			</staticContent>
		</system.webServer>
	</location>

</configuration>
